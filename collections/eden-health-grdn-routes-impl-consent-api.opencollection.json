          },
          "docs": "Given a consent name, depending on feature flags, gets latest version of the consent form or the\n   sponsor-specific covid consent version."
        },
        {
          "info": {
            "name": "accept-patient-consent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/patient/:patient-id/consent",
            "params": [
              {
                "name": "patient-id",
                "value": "",
